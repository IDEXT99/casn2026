{
  "rules": {
    ".read": false,
    ".write": false,
    "chai_bench_gang": {
      ".read": "auth != null",
      "students_v4": {
        "$id": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['n','c','ord'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
          },
          "c": {
            ".validate": "newData.val() == 'BCA' || newData.val() == 'BSc'"
          },
          "bio": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "pic": {
            ".validate": "newData.isString() && newData.val().length <= 160000"
          },
          "$other": {
            ".validate": "newData.isString() ? newData.val().length <= 200 : true"
          }
        }
      },
      "lots_v5": {
        "$id": {
          ".write": "auth != null && (!data.child('result').exists() || !newData.exists())",
          ".validate": "newData.hasChildren(['name','created']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 40",
          "result": {
            ".write": "auth != null && !data.exists()"
          }
        }
      },
      "presence_v4": {
        ".write": "auth != null"
      },
      "chats": {
        "$room": {
          "$msg": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['type','ts']) && (!newData.hasChild('text') || newData.child('text').val().length <= 1000) && (!newData.hasChild('media') || newData.child('media').val().length <= 800000)"
          }
        },
        ".write": "auth != null"
      },
      "polls_v1": {
        "$id": {
          ".write": "auth != null"
        }
      },
      "groups_v1": {
        "$id": {
          ".write": "auth != null"
        }
      },
      "site_v1": {
        ".write": "auth != null"
      }
    }
  }
}